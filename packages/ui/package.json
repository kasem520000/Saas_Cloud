{
  "name": "@erp/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Design system per ADR-0016 / docs/ui/DESIGN_SYSTEM.md: token layer, Radix primitive wrappers, catalog components, app shell. RTL-first, Arabic-first, WCAG 2.1 AA.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/tokens.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./density.css": "./src/tokens/density.css",
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css",
    "./lint": "./lint/plugin.mjs",
    "./fixtures": "./src/testing/fixtures/index.ts",
    "./print": "./print/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --test --output-dir dist-storybook",
    "test:visual": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:harness": "pnpm build:storybook && pnpm test:visual && pnpm test:perf"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "tailwind-merge": "^3.3.1",
    "@erp/contracts": "workspace:*"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}